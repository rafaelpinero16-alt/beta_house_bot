# =====================================================================
# BETA HOUSE · Bot de gestión de suscripciones (creadores y espectadores)
# Copia este archivo como .env y completa los valores. NUNCA subas el .env a ningún repositorio.
# =====================================================================

# Token de @BotFather (crea un bot NUEVO para Beta House; no reutilices el de Alpha Pig Bros)
BOT_TOKEN=

# Supergrupo de gestión con Temas (bot admin + "Gestionar temas")
ADMIN_GROUP_ID=
# Supergrupo VIP de BETA HOUSE (bot admin + Invitar usuarios + Restringir/expulsar miembros + Eliminar mensajes)
BETA_HOUSE_CHAT_ID=
# Canal de registro de ventas (bot admin + "Publicar mensajes")
SALES_LOG_CHANNEL_ID=
# Canal de contabilidad de donaciones (bot admin + "Publicar mensajes")
TIPS_LOG_CHANNEL_ID=
# Admins autorizados a aprobar pagos y usar /panel (IDs separados por coma)
ADMIN_IDS=

# ---- Precios iniciales (solo el primer arranque; luego se editan en /panel → Suscripciones) ----
CREATOR_STARS_PRICE=1050
CREATOR_PAYPAL_PRICE=15 $ USD
VIEWER_STARS_PRICE=350
VIEWER_PAYPAL_PRICE=5 $ USD

# ---- Enlaces iniciales (luego se editan en /panel → Enlaces) ----
PAYPAL_LINK=https://paypal.me/JaviiTorresDIGITAL
PAYPAL_CREATOR_LINK=
PAYPAL_VIEWER_LINK=
CONTACT_TELEGRAM_LINK=https://t.me/Tjavier_96
CONTACT_X_LINK=https://x.com/Javiitorrees96

# ---- Acceso y roles (se cambian desde /panel) ----
# request = solicitud de ingreso: el bot solo aprueba al miembro que pagó (recomendado) · link = enlace de 1 uso
ACCESS_MODE=request
# Permisos del espectador en el grupo: readonly = solo lectura (recomendado) · text = solo texto, sin multimedia ni enlaces
VIEWER_MODE=readonly
# Aviso privado a los miembros activos cuando empieza un videochat en el grupo: on | off
VIDEOCHAT_ALERT=on
# USD netos que recibes por cada 1000 ⭐ al retirarlas (solo para las estimaciones del panel y /estado)
STARS_USD_PER_1000=13
# Validez del enlace de acceso en segundos (300 - 169200)
INVITE_TTL_SECONDS=86400
# Recordatorio de renovación N días antes de vencer (mínimo 3)
REMINDER_DAYS=3
# button = el miembro escribe al equipo tras pulsar el botón · always = siempre
SUPPORT_MODE=button
SWEEP_INTERVAL_SECONDS=60
SUBSCRIPTION_TITLE=BETA HOUSE VIP
TIMEZONE=America/Bogota

# ---- Donaciones ----
TIPS_ENABLED=true
TIP_AMOUNT_1=150
TIP_AMOUNT_2=250
TIP_AMOUNT_3=500
TIP_AMOUNT_4=750
TIP_AMOUNT_5=1000

# ---- Infraestructura ----
# Railway: Volume montado en /data
DB_PATH=/data/bot_data.db
LOG_LEVEL=INFO
